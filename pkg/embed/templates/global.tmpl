# ---- Action & informational community library ----
# Function names (incl. the "communitys" spelling) are stable: peer hooks
# (pre-export, post-import-filter, ...) call these directly. Community
# numbering comes from the community-ids config map (defaults documented
# in configuration.md).
{{ $ids := .CommunityIDs -}}

{{ if .PopID -}}
define pop_id = {{ IntDeref .PopID }};
{{- end }}

# --- Action: do-not-announce ---
function reject_general(int peer_asn) {
    if ((ASN, {{ $ids.NoAnnounceAS }}, peer_asn) ~ bgp_large_community) then _reject("do not announce to AS");
}
function reject_ix(int ix_id) {
    if ((ASN, {{ $ids.NoAnnounceIX }}, ix_id) ~ bgp_large_community) then _reject("do not announce at IX");
}

# --- Action: prepending ---
function process_prepend_general() {
    {{ range $i := IterateInt 3 }}
    if ((ASN, {{ $ids.PrependGeneral }}, {{ Add $i 1 }}) ~ bgp_large_community) then {
        {{ range IterateInt (Add $i 1) }}bgp_path.prepend(ASN);{{ end }}
        bgp_large_community.delete([(ASN, {{ $ids.PrependGeneral }}, *)]);
    }
    {{ end }}
}
function process_prepend_as(int peer_asn) {
    {{ range $i, $id := $ids.PrependAS }}
    if ((ASN, {{ $id }}, peer_asn) ~ bgp_large_community) then {
        {{ range IterateInt (Add $i 1) }}bgp_path.prepend(ASN);{{ end }}
        {{ range $d := $ids.PrependAS }}bgp_large_community.delete([(ASN, {{ $d }}, peer_asn)]);{{ end }}
    }
    {{ end }}
}
function process_prepend_ix(int ix_id) {
    {{ range $i, $id := $ids.PrependIX }}
    if ((ASN, {{ $id }}, ix_id) ~ bgp_large_community) then {
        {{ range IterateInt (Add $i 1) }}bgp_path.prepend(ASN);{{ end }}
        {{ range $d := $ids.PrependIX }}bgp_large_community.delete([(ASN, {{ $d }}, ix_id)]);{{ end }}
    }
    {{ end }}
}

# --- Informational: RPKI marking ---
function add_rpki_community() {
    {{ if .RPKIEnable -}}
    if (net.type = NET_IP4) then {
        if (roa_check(rpki4, net, bgp_path.last_nonaggregated) = ROA_VALID) then bgp_large_community.add((ASN, {{ $ids.InfoRPKI }}, 100));
        if (roa_check(rpki4, net, bgp_path.last_nonaggregated) = ROA_UNKNOWN) then bgp_large_community.add((ASN, {{ $ids.InfoRPKI }}, 101));
        if (roa_check(rpki4, net, bgp_path.last_nonaggregated) = ROA_INVALID) then bgp_large_community.add((ASN, {{ $ids.InfoRPKI }}, 102));
    }
    if (net.type = NET_IP6) then {
        if (roa_check(rpki6, net, bgp_path.last_nonaggregated) = ROA_VALID) then bgp_large_community.add((ASN, {{ $ids.InfoRPKI }}, 100));
        if (roa_check(rpki6, net, bgp_path.last_nonaggregated) = ROA_UNKNOWN) then bgp_large_community.add((ASN, {{ $ids.InfoRPKI }}, 101));
        if (roa_check(rpki6, net, bgp_path.last_nonaggregated) = ROA_INVALID) then bgp_large_community.add((ASN, {{ $ids.InfoRPKI }}, 102));
    }
    {{- end }}
}
function remove_information_communitys() {
    bgp_large_community.delete([(ASN, {{ $ids.InfoSource }}, *)]);
    bgp_large_community.delete([(ASN, {{ $ids.InfoRPKI }}, *)]);
    bgp_large_community.delete([(ASN, {{ $ids.InfoIX }}, *)]);
    bgp_large_community.delete([(ASN, {{ $ids.InfoUpstream }}, *)]);
    {{ if .PopID -}}
    # this-PoP source/origin tags — a peer must not be able to tag a route
    # into our announce lists (e.g. (ASN,pop,50) posing as a downstream
    # route, or (ASN,pop,100) posing as originated). Other PoPs' tags are
    # harmless: they never match this router's announce lists.
    bgp_large_community.delete([(ASN, pop_id, *)]);
    {{- end }}
}
function add_on_import() {
    bgp_large_community.add((ASN, {{ $ids.InfoSource }}, pop_id));
}
function add_on_export() {
    bgp_community.add((ASN, {{ $ids.DownstreamTag }}));
    bgp_large_community.add((ASN, {{ $ids.InfoSource }}, {{ $ids.DownstreamTag }}));
    bgp_large_community.add((ASN, pop_id, {{ $ids.DownstreamTag }}));
}
function add_ix_community(int ix_id) {
    bgp_large_community.add((ASN, {{ $ids.InfoIX }}, ix_id));
}
function add_upstream_community(int upstream_id) {
    bgp_large_community.add((ASN, {{ $ids.InfoUpstream }}, upstream_id));
    bgp_large_community.add((ASN, {{ $ids.InfoSource }}, {{ $ids.UpstreamTag }}));
    bgp_community.add((ASN, {{ $ids.UpstreamTag }}));
}

# --- Composed import/export pipelines ---
function import_communitys(int peer_asn; int pop_id; int import_src_id) {
    remove_information_communitys();
    add_on_import();
    bgp_large_community.add((ASN, {{ $ids.InfoSource }}, peer_asn));
    bgp_large_community.add((ASN, pop_id, peer_asn));
    bgp_large_community.add((ASN, pop_id, import_src_id));
    add_rpki_community();
}
function downstream_communitys(int peer_asn; int pop_id) {
    remove_information_communitys();
    add_on_import();
    bgp_community.add((ASN, {{ $ids.DownstreamTag }}));
    bgp_community.add((ASN, pop_id));
    bgp_large_community.add((ASN, {{ $ids.InfoSource }}, {{ $ids.DownstreamTag }}));
    bgp_large_community.add((ASN, {{ $ids.DownstreamTag }}, pop_id));
    add_rpki_community();
}
function export_communitys(int peer_asn) {
    reject_general(peer_asn);
    process_prepend_general();
    process_prepend_as(peer_asn);
    add_on_export();
}
function export_ix_communitys(int ix_id) {
    reject_ix(ix_id);
    process_prepend_ix(ix_id);
}
